# Copy this file to `.env` and fill in real values.
# `backend/.env` is gitignored — never commit your actual credentials.

# MongoDB Atlas connection string (or local `mongodb://localhost:27017`)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name to use inside the cluster
MONGO_DB_NAME=binary_brains

# Allowed origin for the React dev server
CORS_ORIGIN=http://localhost:5173
