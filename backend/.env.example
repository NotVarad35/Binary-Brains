# Copy this file to `.env` and fill in real values.
# `backend/.env` is gitignored — never commit your actual credentials.

# MongoDB Atlas connection string (or local `mongodb://localhost:27017`)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name to use inside the cluster
MONGO_DB_NAME=binary_brains

# How long to wait for Mongo before giving up, in milliseconds.
# Keeps `uvicorn main:app` startup fast when the URI is wrong/unreachable.
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# NOTE: CORS is wide open in main.py (allow_origins=["*"]) so both the local
# Vite server and the deployed frontend reach the API with no extra config.
